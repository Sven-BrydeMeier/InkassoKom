# InkassoKom - Streamlit Secrets Konfiguration
# Kopieren Sie diese Datei nach secrets.toml und tragen Sie Ihre Werte ein

# =============================================================================
# SUPABASE DATENBANK
# =============================================================================
# EMPFOHLEN: Verwenden Sie die vollständige Datenbank-URL aus dem Supabase Dashboard
# (Project Settings → Database → Connection string → URI)

[supabase]
# Option 1: Vollständige URL (EMPFOHLEN für Supabase)
# Für Transaction Pooler (Port 6543):
url = "postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Für Session Pooler (Port 5432):
# url = "postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Für direkte Verbindung (nicht empfohlen für Serverless):
# url = "postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Option 2: Einzelne Parameter (falls URL nicht gewünscht)
# host = "aws-0-eu-central-1.pooler.supabase.com"
# port = 6543
# database = "postgres"
# user = "postgres.abcdefghijklmnop"  # WICHTIG: Bei Pooler muss User "postgres.[PROJECT-REF]" sein!
# password = "your-database-password"

# =============================================================================
# REDIS CACHE (Optional, aber empfohlen für bessere Performance)
# =============================================================================
[redis]
# Für SSL-Verbindungen (Upstash, Redis Cloud, etc.) verwenden Sie rediss:// (mit doppeltem s)
url = "rediss://default:[PASSWORD]@[HOST]:[PORT]"

# Beispiel für Upstash Redis (SSL erforderlich):
# url = "rediss://default:xxx@eu1-xxx.upstash.io:6379"

# Beispiel für lokalen Redis (ohne SSL):
# url = "redis://localhost:6379"

# Optional: SSL explizit aktivieren (falls URL mit redis:// beginnt aber SSL benötigt)
# ssl = true

# =============================================================================
# OPENAI API (Optional, für KI-Funktionen)
# =============================================================================
[openai]
api_key = "sk-..."

# =============================================================================
# ANWENDUNG
# =============================================================================
[app]
secret_key = "your-32-character-secret-key-here"
debug = false

# =============================================================================
# HINWEISE
# =============================================================================
# 1. Supabase URL finden:
#    - Supabase Dashboard öffnen
#    - Project Settings → Database → Connection string
#    - "URI" kopieren und [YOUR-PASSWORD] ersetzen
#
# 2. Bei "Tenant or user not found" Fehler:
#    - Stellen Sie sicher, dass der Benutzername "postgres.[PROJECT-REF]" enthält
#    - Überprüfen Sie das Passwort (Sonderzeichen URL-kodieren!)
#    - Verwenden Sie besser die vollständige URL statt einzelner Parameter
#
# 3. Redis (optional):
#    - Upstash bietet kostenlosen Redis-Tier
#    - Verbessert Performance durch Caching
