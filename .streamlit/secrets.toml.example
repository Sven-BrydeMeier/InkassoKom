# Supabase/PostgreSQL Konfiguration
# Kopieren Sie diese Datei nach secrets.toml und tragen Sie Ihre Werte ein

[supabase]
host = "db.xxxxxxxxxxxx.supabase.co"
port = 5432
database = "postgres"
user = "postgres"
password = "your-supabase-password"
pool_size = 5
max_overflow = 10
ssl_mode = "require"

# Redis Cache (optional, aber empfohlen)
[redis]
url = "redis://default:password@your-redis-host:6379"

# OpenAI API Key (optional, für AI Copilot)
[openai]
api_key = "sk-..."

# Weitere Geheimnisse
[app]
secret_key = "your-32-character-secret-key-here"
